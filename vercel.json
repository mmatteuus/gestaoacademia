{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/rows(/.*)?", "dest": "/server.js" },
    { "src": "/status", "dest": "/server.js" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}

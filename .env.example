SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
PORT=3000

# Segurança
CORS_ALLOWLIST=http://localhost:5173,http://localhost:8080,http://localhost:3000
API_BODY_LIMIT=64kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MUTATIONS=120
RATE_LIMIT_MAX_READS=300

# API Key (opcional — se definida, todas as requests precisam do header X-API-Key)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Frontend API base URL. Keep empty in production (same host).
VITE_API_URL=
